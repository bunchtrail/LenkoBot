# Copy to /etc/lenkobot/lenkobot.env, fill in the real token, then:
#   sudo chown root:lenkobot /etc/lenkobot/lenkobot.env
#   sudo chmod 0640 /etc/lenkobot/lenkobot.env
#
# This file is the only place the Telegram token lives. It must never be
# committed, copied into config.toml, or included in an export.

TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Only needed when [provider] name = "xai" and the Tavily search backend is on.
# TAVILY_API_KEY=
